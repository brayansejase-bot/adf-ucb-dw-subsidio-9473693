{
	"name": "df_hechos_logistica",
	"properties": {
		"folder": {
			"name": "gold"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "silver_agencia_recepciones",
						"type": "DatasetReference"
					},
					"name": "recepciones"
				},
				{
					"dataset": {
						"referenceName": "silver_agencia_despachos",
						"type": "DatasetReference"
					},
					"name": "despachos"
				},
				{
					"dataset": {
						"referenceName": "gold_dim_tiempo",
						"type": "DatasetReference"
					},
					"name": "dimTiempo"
				},
				{
					"dataset": {
						"referenceName": "gold_dim_almacen",
						"type": "DatasetReference"
					},
					"name": "dimAlmacen"
				},
				{
					"dataset": {
						"referenceName": "gold_dim_transporte_vehiculo",
						"type": "DatasetReference"
					},
					"name": "dimTransporte"
				},
				{
					"dataset": {
						"referenceName": "silver_agencia_recepciones",
						"type": "DatasetReference"
					},
					"name": "auxrecep"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "gold_hechos_agencia_logistica",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "derivedColumn1"
				},
				{
					"name": "derivedColumn2"
				},
				{
					"name": "join1"
				},
				{
					"name": "join2"
				},
				{
					"name": "join3"
				},
				{
					"name": "join4"
				},
				{
					"name": "join5"
				},
				{
					"name": "join6"
				},
				{
					"name": "derivedColumn3"
				},
				{
					"name": "derivedColumn4"
				},
				{
					"name": "join7"
				},
				{
					"name": "select1"
				},
				{
					"name": "union1"
				},
				{
					"name": "select2"
				},
				{
					"name": "select3"
				}
			],
			"scriptLines": [
				"source(output(",
				"          recepcion_id as integer,",
				"          nro_lote as string,",
				"          almacen_id as integer,",
				"          transportista_id as integer,",
				"          vehiculo_id as integer,",
				"          fecha_recepcion as date,",
				"          cantidad_recibida as decimal(12,3),",
				"          unidad as string,",
				"          condicion as string,",
				"          estado as string,",
				"          responsable as string,",
				"          nro_guia_remision as string,",
				"          temperatura_llegada as decimal(5,2)",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> recepciones",
				"source(output(",
				"          despacho_id as integer,",
				"          recepcion_id as integer,",
				"          nro_lote as string,",
				"          almacen_id as integer,",
				"          transportista_id as integer,",
				"          vehiculo_id as integer,",
				"          fecha_despacho as date,",
				"          cantidad_despachada as decimal(12,3),",
				"          centro_destino as string,",
				"          estado as string,",
				"          responsable as string,",
				"          nro_guia_despacho as string,",
				"          fecha_llegada as date",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> despachos",
				"source(output(",
				"          fecha_key as integer,",
				"          fecha as date,",
				"          mes as integer,",
				"          anio as integer,",
				"          trimestre as integer",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> dimTiempo",
				"source(output(",
				"          almacen_key as integer,",
				"          almacen_id_origen as integer,",
				"          nombre as string,",
				"          municipio as string,",
				"          departamento as string,",
				"          capacidad_m3 as decimal(10,2),",
				"          estado as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> dimAlmacen",
				"source(output(",
				"          transporte_key as integer,",
				"          transportista_id_origen as integer,",
				"          razon_social as string,",
				"          nit as string,",
				"          transportista_estado as string,",
				"          vehiculo_id_origen as integer,",
				"          placa as string,",
				"          tipo_vehiculo as string,",
				"          capacidad_kg as decimal(10,2),",
				"          vehiculo_estado as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> dimTransporte",
				"source(output(",
				"          recepcion_id as integer,",
				"          nro_lote as string,",
				"          almacen_id as integer,",
				"          transportista_id as integer,",
				"          vehiculo_id as integer,",
				"          fecha_recepcion as date,",
				"          cantidad_recibida as decimal(12,3),",
				"          unidad as string,",
				"          condicion as string,",
				"          estado as string,",
				"          responsable as string,",
				"          nro_guia_remision as string,",
				"          temperatura_llegada as decimal(5,2)",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> auxrecep",
				"recepciones derive(fecha_key_calc = toInteger(concat(toString(year(toTimestamp(fecha_recepcion))), iif(month(toTimestamp(fecha_recepcion))<10, concat('0',toString(month(toTimestamp(fecha_recepcion)))), toString(month(toTimestamp(fecha_recepcion)))), iif(dayOfMonth(toTimestamp(fecha_recepcion))<10, concat('0',toString(dayOfMonth(toTimestamp(fecha_recepcion)))), toString(dayOfMonth(toTimestamp(fecha_recepcion))))))) ~> derivedColumn1",
				"despachos derive(fecha_key_calc = toInteger(concat(toString(year(toTimestamp(fecha_despacho))), iif(month(toTimestamp(fecha_despacho))<10, concat('0',toString(month(toTimestamp(fecha_despacho)))), toString(month(toTimestamp(fecha_despacho)))), iif(dayOfMonth(toTimestamp(fecha_despacho))<10, concat('0',toString(dayOfMonth(toTimestamp(fecha_despacho)))), toString(dayOfMonth(toTimestamp(fecha_despacho))))))) ~> derivedColumn2",
				"derivedColumn1, dimTiempo join(fecha_key_calc == fecha_key,",
				"     joinType:'left',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> join1",
				"derivedColumn2, dimTiempo join(fecha_key_calc == fecha_key,",
				"     joinType:'left',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> join2",
				"join1, dimAlmacen join(almacen_id == almacen_id_origen,",
				"     joinType:'left',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> join3",
				"join2, dimAlmacen join(almacen_id == almacen_id_origen,",
				"     joinType:'left',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> join4",
				"join3, dimTransporte join(vehiculo_id == vehiculo_id_origen,",
				"     joinType:'left',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> join5",
				"join4, dimTransporte join(vehiculo_id == vehiculo_id_origen,",
				"     joinType:'left',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> join6",
				"select2 derive(tipo_movimiento = 'Recepcion',",
				"          recepcion_id = recepcion_id,",
				"          cantidad = cantidad_recibida,",
				"          unidad = unidad,",
				"          condicion_o_estado = condicion,",
				"          centro_destino = toString(null()),",
				"          temperatura_llegada = temperatura_llegada,",
				"          nro_guia = nro_guia_remision) ~> derivedColumn3",
				"select3 derive(tipo_movimiento = 'Despacho',",
				"          recepcion_id = recepcion_id,",
				"          cantidad = cantidad_despachada,",
				"          unidad = unidad,",
				"          condicion_o_estado = estado,",
				"          centro_destino = centro_destino,",
				"          temperatura_llegada = toFloat(null()),",
				"          nro_guia = nro_guia_despacho) ~> derivedColumn4",
				"join6, auxrecep join(despachos@recepcion_id == auxrecep@recepcion_id,",
				"     joinType:'left',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> join7",
				"union1 select(mapColumn(",
				"          nro_lote,",
				"          unidad,",
				"          responsable,",
				"          temperatura_llegada,",
				"          fecha_key,",
				"          almacen_key,",
				"          transporte_key,",
				"          cantidad,",
				"          condicion_o_estado,",
				"          centro_destino,",
				"          nro_guia,",
				"          tipo_movimiento,",
				"          resepcion_id = recepcion_id",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select1",
				"derivedColumn3, derivedColumn4 union(byName: true)~> union1",
				"join5 select(mapColumn(",
				"          recepcion_id,",
				"          nro_lote,",
				"          almacen_id,",
				"          transportista_id,",
				"          vehiculo_id,",
				"          fecha_recepcion,",
				"          cantidad_recibida,",
				"          unidad,",
				"          condicion,",
				"          estado = recepciones@estado,",
				"          responsable,",
				"          nro_guia_remision,",
				"          temperatura_llegada,",
				"          fecha_key_calc,",
				"          fecha_key,",
				"          fecha,",
				"          mes,",
				"          anio,",
				"          trimestre,",
				"          almacen_key,",
				"          almacen_id_origen,",
				"          nombre,",
				"          municipio,",
				"          departamento,",
				"          capacidad_m3,",
				"          estado = dimAlmacen@estado,",
				"          transporte_key,",
				"          transportista_id_origen,",
				"          razon_social,",
				"          nit,",
				"          transportista_estado,",
				"          vehiculo_id_origen,",
				"          placa,",
				"          tipo_vehiculo,",
				"          capacidad_kg,",
				"          vehiculo_estado",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select2",
				"join7 select(mapColumn(",
				"          despacho_id,",
				"          recepcion_id = despachos@recepcion_id,",
				"          nro_lote = despachos@nro_lote,",
				"          almacen_id = despachos@almacen_id,",
				"          transportista_id = despachos@transportista_id,",
				"          vehiculo_id = despachos@vehiculo_id,",
				"          fecha_despacho,",
				"          cantidad_despachada,",
				"          centro_destino,",
				"          estado = despachos@estado,",
				"          responsable = despachos@responsable,",
				"          nro_guia_despacho,",
				"          fecha_llegada,",
				"          fecha_key_calc,",
				"          fecha_key,",
				"          fecha,",
				"          mes,",
				"          anio,",
				"          trimestre,",
				"          almacen_key,",
				"          almacen_id_origen,",
				"          nombre,",
				"          municipio,",
				"          departamento,",
				"          capacidad_m3,",
				"          estado = dimAlmacen@estado,",
				"          transporte_key,",
				"          transportista_id_origen,",
				"          razon_social,",
				"          nit,",
				"          transportista_estado,",
				"          vehiculo_id_origen,",
				"          placa,",
				"          tipo_vehiculo,",
				"          capacidad_kg,",
				"          vehiculo_estado,",
				"          recepcion_id = auxrecep@recepcion_id,",
				"          almacen_id = auxrecep@almacen_id,",
				"          transportista_id = auxrecep@transportista_id,",
				"          vehiculo_id = auxrecep@vehiculo_id,",
				"          fecha_recepcion,",
				"          cantidad_recibida,",
				"          unidad,",
				"          condicion,",
				"          estado = auxrecep@estado,",
				"          responsable = auxrecep@responsable,",
				"          nro_guia_remision,",
				"          temperatura_llegada",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select3",
				"select1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          movimiento_key as integer,",
				"          fecha_key as integer,",
				"          almacen_key as integer,",
				"          transporte_key as integer,",
				"          tipo_movimiento as string,",
				"          nro_lote as string,",
				"          recepcion_id_origen as integer,",
				"          cantidad as decimal(12,3),",
				"          unidad as string,",
				"          condicion_o_estado as string,",
				"          centro_destino as string,",
				"          temperatura_llegada as decimal(5,2),",
				"          nro_guia as string",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     mapColumn(",
				"          fecha_key,",
				"          almacen_key,",
				"          transporte_key,",
				"          tipo_movimiento,",
				"          nro_lote,",
				"          recepcion_id_origen = resepcion_id,",
				"          cantidad,",
				"          unidad,",
				"          condicion_o_estado,",
				"          centro_destino,",
				"          temperatura_llegada,",
				"          nro_guia",
				"     )) ~> sink1"
			]
		}
	}
}