				"prenatal derive(fecha_key_calc = toInteger(concat(toString(year(toTimestamp(fecha_control))), iif(month(toTimestamp(fecha_control))<10, concat('0',toString(month(toTimestamp(fecha_control)))), toString(month(toTimestamp(fecha_control)))), iif(dayOfMonth(toTimestamp(fecha_control))<10, concat('0',toString(dayOfMonth(toTimestamp(fecha_control)))), toString(dayOfMonth(toTimestamp(fecha_control))))))) ~> derivedColumn1",
